# Copy to backend/.env (local) or set these in your hosting provider's dashboard.
# NEVER commit real secrets. All secrets stay server-side — the Angular app never sees them.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200 # comma-separated; add your Vercel URL in production
APP_ACCESS_TOKEN=                  # optional: require this token (X-Access-Token) for all /api calls
MAX_JOBS_PER_HOUR_PER_IP=20

# --- Database ----------------------------------------------------------------
# Local quick start uses SQLite. Production: PostgreSQL (Render/Railway/Neon/Supabase URL works as-is).
DATABASE_URL=sqlite:///./research_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/research_agent
AUTO_CREATE_TABLES=true            # set false when using Alembic migrations (Docker does)

# --- LLM (OpenAI or any OpenAI-compatible API) ------------------------------------
LLM_PROVIDER=openai                # openai | none (heuristic-only mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # optional, e.g. https://api.deepseek.com/v1 or DashScope compatible endpoint
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=12000

# --- Web search fallback (optional) --------------------------------------------
SEARCH_PROVIDER=none               # none | serper | brave | tavily | searxng
SEARCH_API_KEY=
SEARXNG_URL=

# --- Crawling --------------------------------------------------------------------
MAX_PAGES_PER_JOB=200
REQUEST_DELAY_SECONDS=1.0          # per-host delay between requests
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_REQUESTS=4
RESPECT_ROBOTS_TXT=true
CACHE_TTL_HOURS=72
# Recommended: many faculty pages fill in the email with JavaScript.
# Needs `pip install playwright && playwright install chromium` (the Docker image can include it).
PLAYWRIGHT_ENABLED=false

# --- Research workflow -----------------------------------------------------------
MAX_PROFESSORS=40
MAX_DEPARTMENTS=5
ALLOW_NON_INSTITUTIONAL_EMAILS=false
# DEFAULT_FIELDS=Computer Science,Artificial Intelligence,Machine Learning

# --- Jobs ------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
